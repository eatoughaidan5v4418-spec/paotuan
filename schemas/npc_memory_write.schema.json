{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC Memory Write",
  "type": "object",
  "additionalProperties": false,
  "required": ["writes", "updates"],
  "properties": {
    "writes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_npc_id",
          "type",
          "content",
          "observed_at",
          "location_id",
          "source",
          "confidence",
          "salience",
          "emotional_valence",
          "visibility",
          "related_entities"
        ],
        "properties": {
          "owner_npc_id": {"type": "string"},
          "type": {"enum": ["episodic", "semantic", "procedural"]},
          "content": {"type": "string"},
          "observed_at": {"type": "string"},
          "location_id": {"type": "string"},
          "source": {"enum": ["saw", "heard", "inferred", "rumor"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "salience": {"type": "number", "minimum": 0, "maximum": 1},
          "emotional_valence": {"type": "number", "minimum": -2, "maximum": 2},
          "visibility": {"enum": ["private"]},
          "related_entities": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["memory_id", "patch"],
        "properties": {
          "memory_id": {"type": "string"},
          "patch": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "invalid_at": {"type": "string"},
              "contradicted_by": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

