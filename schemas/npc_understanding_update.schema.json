{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC Understanding Update",
  "type": "object",
  "additionalProperties": false,
  "required": ["new_understandings", "updates"],
  "properties": {
    "new_understandings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "npc_id",
          "type",
          "text",
          "supporting_interpretation_ids",
          "supporting_memory_ids",
          "contradicting_interpretation_ids",
          "confidence",
          "stability",
          "importance",
          "tier",
          "behavior_effect"
        ],
        "properties": {
          "id": {"type": "string"},
          "npc_id": {"type": "string"},
          "type": {"enum": ["belief", "attitude", "relationship_judgment", "schema", "plan_rule", "self_understanding"]},
          "text": {"type": "string"},
          "supporting_interpretation_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "supporting_memory_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "contradicting_interpretation_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "stability": {"type": "number", "minimum": 0, "maximum": 1},
          "importance": {"type": "number", "minimum": 0, "maximum": 1},
          "tier": {"enum": ["core", "active", "dormant", "archive"]},
          "behavior_effect": {"type": "string"}
        }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "understanding_id",
          "confidence_delta",
          "stability_delta",
          "new_supporting_interpretation_ids",
          "new_contradicting_interpretation_ids",
          "new_tier",
          "reason"
        ],
        "properties": {
          "understanding_id": {"type": "string"},
          "confidence_delta": {"type": "number", "minimum": -1, "maximum": 1},
          "stability_delta": {"type": "number", "minimum": -1, "maximum": 1},
          "new_supporting_interpretation_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "new_contradicting_interpretation_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "new_tier": {"enum": ["core", "active", "dormant", "archive"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}

